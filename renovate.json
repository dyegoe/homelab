{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "argocd": {
    "managerFilePatterns": [
      "/^argocd/.+\\.ya?ml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/^addons/.+/(deployment|cronjob).*\\.ya?ml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^argocd/install/kustomization\\.yaml$/"
      ],
      "matchStrings": [
        "raw\\.githubusercontent\\.com/argoproj/argo-cd/(?<currentValue>v[0-9.]+)/manifests/install\\.yaml"
      ],
      "depNameTemplate": "argoproj/argo-cd",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Talos version in the Omni cluster template",
      "managerFilePatterns": [
        "/^talos/cluster\\.yaml$/"
      ],
      "matchStrings": [
        "\\ntalos:\\n  version: (?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "siderolabs/talos",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Kubernetes version in the Omni cluster template; tracks Sidero's kubelet image tags, since that is what Omni rolls out",
      "managerFilePatterns": [
        "/^talos/cluster\\.yaml$/"
      ],
      "matchStrings": [
        "\\nkubernetes:\\n  version: (?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "ghcr.io/siderolabs/kubelet",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Container images referenced from Talos patches and Omni healthchecks",
      "managerFilePatterns": [
        "/^talos/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "image: (?<depName>[^\\s:]+):(?<currentValue>[^\\s@]+)"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Kubernetes version bumps land as one kubernetes (Omni) PR, applied with omnictl cluster template sync",
      "matchDepNames": [
        "ghcr.io/siderolabs/kubelet"
      ],
      "groupName": "kubernetes (Omni)"
    }
  ]
}
