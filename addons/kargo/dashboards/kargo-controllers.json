{
  "id": null,
  "uid": "kargo-controllers",
  "title": "Kargo Controllers",
  "description": "Kargo exposes no business-level metrics (no per-Promotion/Stage/Warehouse counters) as of chart 1.11.2 - controller, managementController, and webhooksServer only emit generic controller-runtime/workqueue/Go-runtime instrumentation (api and garbageCollector expose no metrics at all). The 'controller' label on these generic metrics does map to real Kargo resource types (promotion/stage/warehouse/control_flow_stage on the main controller; project/projectconfig/namespace/etc. on the management controller), so reconcile rate/errors/latency per resource type is still a genuine signal - just not promotion counts or freight/verification outcomes. Recheck against a newer Kargo version if this matters more once real Warehouses/Stages exist.",
  "tags": ["kargo", "monitoring", "prometheus"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values({namespace=\"kargo\"}, job)",
        "query": "label_values({namespace=\"kargo\"}, job)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "allValue": ".*",
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "options": []
      }
    ]
  },
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Number of Kargo metrics targets (controller, managementController, webhooksServer) currently up. api and garbageCollector never appear here - they expose no metrics endpoint.\n",
      "fieldConfig": {
        "defaults": {
          "unit": "targets",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 3 }
            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "options": {
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(up{job=~\"$job\"})\n",
          "instant": true,
          "legendFormat": "__auto",
          "range": false
        }
      ],
      "title": "Targets up",
      "type": "stat",
      "id": 1
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Combined reconcile rate across every Kargo controller/reconciler.\n",
      "fieldConfig": {
        "defaults": { "unit": "ops" }
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "options": {
        "colorMode": "none",
        "graphMode": "area"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(controller_runtime_reconcile_total{job=~\"$job\"}[$__rate_interval]))\n",
          "instant": false,
          "legendFormat": "__auto",
          "range": true
        }
      ],
      "title": "Reconcile rate (all controllers)",
      "type": "stat",
      "id": 2
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Combined reconcile error rate across every Kargo controller/reconciler. Should be 0 outside of transient API-server hiccups.\n",
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.01 }
            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "options": {
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(controller_runtime_reconcile_total{job=~\"$job\", result=\"error\"}[$__rate_interval]))\n",
          "instant": false,
          "legendFormat": "__auto",
          "range": true
        }
      ],
      "title": "Reconcile error rate (all controllers)",
      "type": "stat",
      "id": 3
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Container restarts per Kargo pod (kube-state-metrics). Includes api/garbageCollector even though they aren't otherwise on this dashboard.\n",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "options": {
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"kargo\"}[1h]))\n",
          "instant": true,
          "legendFormat": "__auto",
          "range": false
        }
      ],
      "title": "Container restarts (last 1h)",
      "type": "stat",
      "id": 4
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Reconcile rate per Kargo resource type. The 'controller' label names the actual reconciler (promotion/stage/warehouse/control_flow_stage on the main controller job; project/projectconfig/namespace/serviceaccount/... on the management controller job).\n",
      "fieldConfig": {
        "defaults": { "unit": "ops" }
      },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 4 },
      "options": {
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (controller) (rate(controller_runtime_reconcile_total{job=~\"$job\"}[$__rate_interval]))\n",
          "instant": false,
          "legendFormat": "{{controller}}",
          "range": true
        }
      ],
      "title": "Reconcile rate by resource type",
      "type": "timeseries",
      "id": 5
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Reconcile error rate per Kargo resource type.\n",
      "fieldConfig": {
        "defaults": { "unit": "ops" }
      },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 4 },
      "options": {
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (controller) (rate(controller_runtime_reconcile_total{job=~\"$job\", result=\"error\"}[$__rate_interval]))\n",
          "instant": false,
          "legendFormat": "{{controller}}",
          "range": true
        }
      ],
      "title": "Reconcile errors by resource type",
      "type": "timeseries",
      "id": 6
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "99th percentile time to complete a reconcile, per resource type. Sustained growth here means something (e.g. a slow Git/registry lookup on Warehouse reconciles) is getting worse.\n",
      "fieldConfig": {
        "defaults": { "unit": "s" }
      },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 13 },
      "options": {
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum by (le, controller) (rate(controller_runtime_reconcile_time_seconds_bucket{job=~\"$job\"}[$__rate_interval])))\n",
          "instant": false,
          "legendFormat": "{{controller}}",
          "range": true
        }
      ],
      "title": "Reconcile duration (p99) by resource type",
      "type": "timeseries",
      "id": 7
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Number of items currently queued for reconciliation, per resource type's workqueue. Sustained non-zero depth means reconciles aren't keeping up.\n",
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 13 },
      "options": {
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (controller) (workqueue_depth{job=~\"$job\"})\n",
          "instant": false,
          "legendFormat": "{{controller}}",
          "range": true
        }
      ],
      "title": "Workqueue depth by resource type",
      "type": "timeseries",
      "id": 8
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "99th percentile time an item sits in the workqueue before a worker picks it up, per resource type.\n",
      "fieldConfig": {
        "defaults": { "unit": "s" }
      },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 22 },
      "options": {
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum by (le, controller) (rate(workqueue_queue_duration_seconds_bucket{job=~\"$job\"}[$__rate_interval])))\n",
          "instant": false,
          "legendFormat": "{{controller}}",
          "range": true
        }
      ],
      "title": "Workqueue latency (p99) by resource type",
      "type": "timeseries",
      "id": 9
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Workqueue retry rate per resource type - a reconcile requeued due to an error.\n",
      "fieldConfig": {
        "defaults": { "unit": "ops" }
      },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 22 },
      "options": {
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (controller) (rate(workqueue_retries_total{job=~\"$job\"}[$__rate_interval]))\n",
          "instant": false,
          "legendFormat": "{{controller}}",
          "range": true
        }
      ],
      "title": "Workqueue retries by resource type",
      "type": "timeseries",
      "id": 10
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Resident memory per Kargo pod.\n",
      "fieldConfig": {
        "defaults": { "unit": "bytes" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 31 },
      "options": {
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (pod) (process_resident_memory_bytes{job=~\"$job\"})\n",
          "instant": false,
          "legendFormat": "{{pod}}",
          "range": true
        }
      ],
      "title": "Memory usage",
      "type": "timeseries",
      "id": 11
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Goroutine count per Kargo pod - a steady climb can indicate a leak.\n",
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 31 },
      "options": {
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (pod) (go_goroutines{job=~\"$job\"})\n",
          "instant": false,
          "legendFormat": "{{pod}}",
          "range": true
        }
      ],
      "title": "Goroutines",
      "type": "timeseries",
      "id": 12
    }
  ]
}
