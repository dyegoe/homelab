{
  "id": null,
  "uid": "alloy-controller",
  "title": "Alloy Controller",
  "tags": [
    "alloy",
    "monitoring",
    "prometheus"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(alloy_build_info, pod)",
        "query": "label_values(alloy_build_info, pod)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "allValue": ".*",
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "options": []
      }
    ]
  },
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "The number of Alloy instances whose metrics are being sent and reported.\n",
      "fieldConfig": {
        "defaults": {
          "unit": "instances"
        }
      },
      "gridPos": {
        "h": 4,
        "w": 10,
        "x": 0,
        "y": 0
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(group(alloy_component_controller_running_components{}) by (instance))\n",
          "instant": false,
          "legendFormat": "__auto",
          "range": true
        }
      ],
      "title": "Running instances",
      "type": "stat",
      "id": 1
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "The number of running components across all running instances.\n",
      "fieldConfig": {
        "defaults": {
          "unit": "components"
        }
      },
      "gridPos": {
        "h": 4,
        "w": 10,
        "x": 10,
        "y": 0
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(alloy_component_controller_running_components{})\n",
          "instant": false,
          "legendFormat": "__auto",
          "range": true
        }
      ],
      "title": "Running components",
      "type": "stat",
      "id": 2
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "The percentage of components which are in a healthy state.\n",
      "fieldConfig": {
        "defaults": {
          "max": 1,
          "min": 0,
          "noValue": "No components",
          "unit": "percentunit"
        }
      },
      "gridPos": {
        "h": 4,
        "w": 10,
        "x": 0,
        "y": 4
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "text": {
          "valueSize": 80
        }
      },
      "pluginVersion": "9.0.6",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(alloy_component_controller_running_components{health_type=\"healthy\"}) /\nsum(alloy_component_controller_running_components{})\n",
          "instant": false,
          "legendFormat": "__auto",
          "range": true
        }
      ],
      "title": "Overall component health",
      "type": "stat",
      "id": 3
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Breakdown of components by health across all running instances.\n\n* Healthy: components have been evaluated completely and are reporting themselves as healthy.\n* Unhealthy: Components either could not be evaluated or are reporting themselves as unhealthy.\n* Unknown: A component has been created but has not yet been started.\n* Exited: A component has exited. It will not return to the running state.\n\nMore information on a component's health state can be retrieved using\nthe Alloy UI.\n\nNote that components may be in a degraded state even if they report\nthemselves as healthy. Use component-specific dashboards and alerts\nto observe detailed information about the behavior of a component.\n",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Unhealthy"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Unknown"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "blue",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Exited"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 12,
        "w": 14,
        "x": 10,
        "y": 4
      },
      "options": {
        "orientation": "vertical",
        "showUnfilled": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(alloy_component_controller_running_components{health_type=\"healthy\"}) or vector(0)\n",
          "instant": true,
          "legendFormat": "Healthy",
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(alloy_component_controller_running_components{health_type=\"unhealthy\"}) or vector(0)\n",
          "instant": true,
          "legendFormat": "Unhealthy",
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(alloy_component_controller_running_components{health_type=\"unknown\"}) or vector(0)\n",
          "instant": true,
          "legendFormat": "Unknown",
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(alloy_component_controller_running_components{health_type=\"exited\"}) or vector(0)\n",
          "instant": true,
          "legendFormat": "Exited",
          "range": false
        }
      ],
      "title": "Components by health",
      "type": "bargauge",
      "id": 4
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "The frequency at which components get updated.\n",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "points",
            "pointSize": 3
          },
          "unit": "ops"
        }
      },
      "gridPos": {
        "h": 10,
        "w": 8,
        "x": 0,
        "y": 14
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (pod) (rate(alloy_component_evaluation_seconds_count{}[$__rate_interval]))\n",
          "instant": false,
          "legendFormat": "__auto",
          "range": true
        }
      ],
      "title": "Component evaluation rate",
      "type": "timeseries",
      "id": 5
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "The percentiles for how long it takes to complete component evaluations.\n\nComponent evaluations must complete for components to have the latest\narguments. The longer the evaluations take, the slower it will be to\nreconcile the state of components.\n\nIf evaluation is taking too long, consider sharding your components to\ndeal with smaller amounts of data and reuse data as much as possible.\n",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 10,
        "w": 8,
        "x": 8,
        "y": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum(rate(alloy_component_evaluation_seconds{}[$__rate_interval])))\nor\nhistogram_quantile(0.99, sum by (le) (rate(alloy_component_evaluation_seconds_bucket{}[$__rate_interval])))\n",
          "instant": false,
          "legendFormat": "99th percentile",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.50, sum(rate(alloy_component_evaluation_seconds{}[$__rate_interval])))\nor\nhistogram_quantile(0.50, sum by (le) (rate(alloy_component_evaluation_seconds_bucket{}[$__rate_interval])))\n",
          "instant": false,
          "legendFormat": "50th percentile",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(\n  histogram_sum(sum(rate(alloy_component_evaluation_seconds{}[$__rate_interval]))) /\n  histogram_count(sum(rate(alloy_component_evaluation_seconds{}[$__rate_interval])))\n)\nor\n(\n  sum(rate(alloy_component_evaluation_seconds_sum{}[$__rate_interval])) /\n  sum(rate(alloy_component_evaluation_seconds_count{}[$__rate_interval]))\n)\n",
          "instant": false,
          "legendFormat": "Average",
          "range": true
        }
      ],
      "title": "Component evaluation time",
      "type": "timeseries",
      "id": 6
    }
  ]
}
