{
  "id": null,
  "uid": "alloy-loki",
  "title": "Alloy Loki Write",
  "tags": [
    "alloy",
    "loki",
    "monitoring",
    "prometheus"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(alloy_build_info, pod)",
        "query": "label_values(alloy_build_info, pod)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "allValue": ".*",
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "options": []
      }
    ]
  },
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Percentage of logs sent by loki.write that succeeded.\n",
      "fieldConfig": {
        "defaults": {
          "max": 100,
          "unit": "%"
        }
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(\n  sum by(pod) (histogram_count(rate(loki_write_request_duration_seconds{pod=~\"$pod\", status_code=~\"2..\"}[$__rate_interval])))\n  or\n  sum by(pod) (rate(loki_write_request_duration_seconds_count{pod=~\"$pod\", status_code=~\"2..\"}[$__rate_interval]))\n)\n/\n(\n  sum by(pod) (histogram_count(rate(loki_write_request_duration_seconds{pod=~\"$pod\"}[$__rate_interval])))\n  or\n  sum by(pod) (rate(loki_write_request_duration_seconds_count{pod=~\"$pod\"}[$__rate_interval]))\n) * 100\n",
          "instant": false,
          "legendFormat": "__auto",
          "range": true
        }
      ],
      "title": "Write requests success rate",
      "type": "timeseries",
      "id": 1
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Percentile write latency.\n",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(\n  0.99,\n  sum by (pod) (\n    rate(loki_write_request_duration_seconds{pod=~\"$pod\"}[$__rate_interval])\n  )\n)\nor ignoring(le)\nhistogram_quantile(\n  0.99,\n  sum by (le, pod) (\n    rate(loki_write_request_duration_seconds_bucket{pod=~\"$pod\"}[$__rate_interval])\n  )\n)\n",
          "instant": false,
          "legendFormat": "{{${groupby}}} p99",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(\n  0.95,\n  sum by (pod) (\n    rate(loki_write_request_duration_seconds{pod=~\"$pod\"}[$__rate_interval])\n  )\n)\nor ignoring(le)\nhistogram_quantile(\n  0.95,\n  sum by (le, pod) (\n    rate(loki_write_request_duration_seconds_bucket{pod=~\"$pod\"}[$__rate_interval])\n  )\n)\n",
          "instant": false,
          "legendFormat": "{{${groupby}}} p95",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(\n  0.50,\n  sum by (pod) (\n    rate(loki_write_request_duration_seconds{pod=~\"$pod\"}[$__rate_interval])\n  )\n)\nor ignoring(le)\nhistogram_quantile(\n  0.50,\n  sum by (le, pod) (\n    rate(loki_write_request_duration_seconds_bucket{pod=~\"$pod\"}[$__rate_interval])\n  )\n)\n",
          "instant": false,
          "legendFormat": "{{${groupby}}} p50",
          "range": true
        }
      ],
      "title": "Write latency",
      "type": "timeseries",
      "id": 2
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Bytes sent per second.\n",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 20,
            "gradientMode": "hue",
            "stacking": {
              "mode": "normal"
            }
          },
          "unit": "Bps"
        }
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (pod) (rate(loki_write_sent_bytes_total{pod=~\"$pod\"}[$__rate_interval]))\n",
          "instant": false,
          "legendFormat": "__auto",
          "range": true
        }
      ],
      "title": "Bytes sent",
      "type": "timeseries",
      "id": 3
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Bytes dropped per second.\n",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 20,
            "gradientMode": "hue",
            "stacking": {
              "mode": "off"
            }
          },
          "unit": "Bps"
        }
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by(pod, reason) (rate(loki_write_dropped_bytes_total{pod=~\"$pod\"}[$__rate_interval]))\n",
          "instant": false,
          "legendFormat": "{{${groupby}}}: {{reason}}",
          "range": true
        }
      ],
      "title": "Bytes dropped",
      "type": "timeseries",
      "id": 4
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Shows distribution of write request sizes over time.\n",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "maxDataPoints": 30,
      "options": {
        "calculate": false,
        "cellGap": 0,
        "color": {
          "scheme": "Spectral"
        },
        "exemplars": {
          "color": "rgba(255,0,255,0.7)"
        },
        "filterValues": {
          "le": 0.1
        },
        "tooltip": {
          "show": true,
          "yHistogram": true
        },
        "yAxis": {
          "unit": "bytes"
        }
      },
      "pluginVersion": "9.0.6",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(loki_write_request_size_bytes{pod=~\"$pod\"}[$__rate_interval]))\nor ignoring (le)\nsum by (le) (increase(loki_write_request_size_bytes_bucket{pod=~\"$pod\"}[$__rate_interval]))\n",
          "format": "heatmap",
          "instant": false,
          "legendFormat": "{{le}}",
          "range": true
        }
      ],
      "title": "Write request size distribution",
      "type": "heatmap",
      "id": 5
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "p99 and p50 of entry propagation latency. Prefers native histogram, falls back to classic histogram when native is unavailable.\n",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(\n  0.99,\n  sum by (pod) (\n\trate(loki_write_entry_propagation_latency_seconds{pod=~\"$pod\"}[$__rate_interval])\n  )\n)\nor ignoring(le)\nhistogram_quantile(\n  0.99,\n  sum by (le, pod) (\n\trate(loki_write_entry_propagation_latency_seconds_bucket{pod=~\"$pod\"}[$__rate_interval])\n  )\n)\n",
          "instant": false,
          "legendFormat": "{{${groupby}}} p99",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(\n  0.50,\n  sum by (pod) (\n\trate(loki_write_entry_propagation_latency_seconds{pod=~\"$pod\"}[$__rate_interval])\n  )\n)\nor ignoring(le)\nhistogram_quantile(\n  0.50,\n  sum by (le, pod) (\n\trate(loki_write_entry_propagation_latency_seconds_bucket{pod=~\"$pod\"}[$__rate_interval])\n  )\n)\n",
          "instant": false,
          "legendFormat": "{{${groupby}}} p50",
          "range": true
        }
      ],
      "title": "Entry propagation latency",
      "type": "timeseries",
      "id": 6
    }
  ]
}
